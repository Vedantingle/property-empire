-- ==========================================
-- PROPERTY EMPIRE - PUNE EDITION - FINAL DB
-- Perfect Schema for Fixed Server + English DB
-- Run this in MySQL Workbench - It will fix all errors
-- ==========================================

DROP DATABASE IF EXISTS property_empire;
CREATE DATABASE property_empire CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE property_empire;

-- 1. PLAYERS - Fixed with all columns server expects
CREATE TABLE players (
  player_id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(100) NOT NULL,
  token VARCHAR(10) DEFAULT 'V',
  color VARCHAR(20) DEFAULT '#FF6B00',
  money INT DEFAULT 1500,
  net_worth INT DEFAULT 1500,
  position INT DEFAULT 0,
  in_jail BOOLEAN DEFAULT FALSE,
  jail_turns INT DEFAULT 0,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 2. PROPERTIES - 40 Pune Properties
CREATE TABLE properties (
  property_id INT PRIMARY KEY,
  name VARCHAR(100) NOT NULL,
  price INT NOT NULL,
  rent INT NOT NULL,
  group_color VARCHAR(20),
  owner_id INT DEFAULT NULL,
  houses INT DEFAULT 0,
  mortgaged BOOLEAN DEFAULT FALSE,
  FOREIGN KEY (owner_id) REFERENCES players(player_id) ON DELETE SET NULL
);

